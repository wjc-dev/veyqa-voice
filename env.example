# Voice Input Next — safe configuration template
# Copy to .env. Never send your real .env, API keys, tokens, personal_context.txt,
# corrections.json, recordings, or logs to another person.

# Select qwen or doubao. Qwen remains the default.
TRANSCRIPTION_SERVICE=qwen

# Qwen3 ASR Realtime / Alibaba Cloud Model Studio (fill only when using Qwen)
QWEN_API_KEY=
# Optional. Leave blank to select the official endpoint for QWEN_REGION.
QWEN_API_HOST=
QWEN_WORKSPACE_ID=
QWEN_REGION=beijing
QWEN_LANGUAGE=zh
QWEN_CONTEXT_ENABLED=false
QWEN_CONTEXT_FILE=personal_context.txt
QWEN_RECENT_MEMORY_ENABLED=false
QWEN_RECENT_MEMORY_COUNT=20

# Doubao Seed ASR 2.0 / Volcengine Speech (fill only when using Doubao)
# DOUBAO_APP_KEY is the numeric App ID; DOUBAO_ACCESS_KEY is the Access Token.
DOUBAO_APP_KEY=
DOUBAO_ACCESS_KEY=
# Optional stronger vocabulary bias: ID created in Volcengine hotword management.
DOUBAO_BOOSTING_TABLE_ID=

# Global push-to-talk shortcut. The native Settings app can record a custom one.
# Presets: fn, left/right_option, left/right_command, left/right_control.
# Right Option requires Input Monitoring. Existing settings are never replaced.
# Registered modifier+key combinations remain available in Settings.
VOICE_HOTKEY=right_option
VOICE_HOTKEY_LABEL=右 Option（⌥）
FN_HOTKEY_MODE=hold
# hold: 按住说话、松开结束；toggle: 按一下开始、再按一下结束
# registered: one exact modifier+key combo, no Input Monitoring permission
# passive: self-healing listen-only event tap, required for modifier-only keys
# off: no global keyboard monitoring; left-click the menu-bar waveform instead
GLOBAL_HOTKEY_BACKEND=passive

# The packaged app registers a bundled, rate-limited supervisor through the
# macOS 13+ Service Management API. Source installs keep their dev LaunchAgent.
LAUNCH_AT_LOGIN=true

# Text output: auto, spaces (keep question marks), or none
PUNCTUATION_MODE=spaces
# 默认关闭：需要时在设置页开启。它只做本地保守清理，不参与 ASR。
DISFLUENCY_FILTER_ENABLED=false
DISFLUENCY_FILTER_MODE=off
# Local voice gate: prevents silence/very short taps from echoing corpus.text.
VOICE_RMS_THRESHOLD=60
MINIMUM_AUDIO_MS=180
MINIMUM_VOICED_AUDIO_MS=100

# Audio capture. Leave AUDIO_INPUT_DEVICE empty to follow macOS system input.
AUDIO_INPUT_DEVICE=
AUDIO_DEVICE_POLICY=system
AUDIO_POST_ROLL_MS=120
AUDIO_ARCHIVE_ENABLED=false

# Experimental automatic edit observation. It is disabled in production until
# the app provides an explicit review/confirmation workflow.
EXPERIMENTAL_CORRECTION_LEARNING=false
CORRECTION_LEARNING_ENABLED=false
CORRECTION_AUTO_REPLACE=false
CORRECTION_REPLACE_MIN_COUNT=2
CORRECTION_CONTEXT_ENABLED=false
CORRECTION_CONTEXT_MIN_COUNT=2

# New installs have both entry points. Existing preferences are preserved.
SHOW_MENU_BAR_ICON=true
# Legacy appearance switches kept only for older configurations.
STATUS_TEXT_ONLY=false
STATUS_ICON_TEMPLATE=false
